# ============================================================
# AI Farming Assistant — Backend Environment Variables
# Copy this file and fill in your real values.
# Never commit the filled-in version to version control.
# ============================================================

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# OpenWeatherMap — get a free key at openweathermap.org/api
# Drop your key in here when ready; nothing else needs to change.
OWM_API_KEY=your-owm-key-here

# Flask
FLASK_ENV=development
FLASK_PORT=5000
